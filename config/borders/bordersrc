#!/bin/bash

# JankyBorders configuration optimized for accessibility
# This configuration uses:
# - High contrast colors for active windows (bright yellow, full opacity)
# - Subtle dark gray for inactive windows with high opacity
# - No background fill to avoid visual clutter
# - Thicker borders (6.0) for better visibility
# - Round corners for visual distinction
# - HiDPI support for retina displays
# - Accessibility API focus for better compatibility
# - Blacklist for system UI elements that don't need borders
#
# NOTE: keep this a single command with no comments between the
# continuation lines — a `#` inside a `\`-continued command swallows the
# backslash and silently drops every option after it.

borders style=round \
  active_color=0xFFFFD700 \
  inactive_color=0xCC333333 \
  background_color=0x00000000 \
  width=6.0 \
  hidpi=on \
  ax_focus=on \
  blacklist="Finder,SystemUIServer,Control Center,Menu Bar,Notification Center"
