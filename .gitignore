# This repository is public. Nothing holding credentials belongs here.
# Those files live in $HOME and stay untracked.
.secrets
.secrets.*
# The placeholder version is safe to publish
!.secrets.template
.netrc
.npmrc
.sentryclirc
.gmail_token.json
.gmail_api_config
.clasprc.json
*token*
*credential*
*_rsa
*_ed25519
*.pem
*.key
.env
.env.*

# Generated by antidote from .zsh_plugins.txt
.zsh_plugins.zsh

# Per-machine overrides. Live in $HOME, never in the repo.
.zshrc.local
.zshenv.local

# Shell state, not configuration
.zsh_history
.zcompdump*
.zsh_sessions/

# Local backups
*.bak
*.bak-*

# Karabiner writes timestamped auto-backups here on every change
config/karabiner/automatic_backups/

# Build artifact; set-wallpapers.sh rebuilds it from setwall.swift on demand
config/yabai/bin/

# Runtime state, not configuration
*.log
config/sunshine/sunshine_state.json
config/zed/prompts/
config/yarn/global/node_modules/
config/notion/cache.json
config/configstore/update-notifier-*.json
config/fontforge/FontsOpenAtLastQuit

# macOS
.DS_Store

# Has its own git repository and history
config/sketchybar/

# Real fabric env holds an API key; only the template is tracked
config/fabric/.env

# Contains a full map of the local network, including MAC-derived IPv6
config/wireshark/
