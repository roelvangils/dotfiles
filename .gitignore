# This repository is public. Nothing holding credentials belongs here.
# Those files live in $HOME and stay untracked.
.secrets
.secrets.*
# The placeholder version is safe to publish
!.secrets.template
.netrc
.npmrc
.sentryclirc
.gmail_token.json
.gmail_api_config
.clasprc.json
*token*
*credential*
*_rsa
*_ed25519
*.pem
*.key
.env
.env.*

# Generated by antidote from .zsh_plugins.txt
.zsh_plugins.zsh

# Shell state, not configuration
.zsh_history
.zcompdump*
.zsh_sessions/

# Local backups
*.bak
*.bak-*

# macOS
.DS_Store

# Has its own git repository and history
config/sketchybar/

# Real fabric env holds an API key; only the template is tracked
config/fabric/.env

# Contains a full map of the local network, including MAC-derived IPv6
config/wireshark/
