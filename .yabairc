#!/usr/bin/env bash

# ~/.yabairc — yabai v7.1.25 (AhsanFazal fork, macOS 27 Golden Gate beta)
# Reload with: yabai --restart-service

# ── scripting addition ────────────────────────────────────────────────────
# Runs passwordless via the hash-pinned rule in /etc/sudoers.d/yabai.
# The SA does NOT survive a Dock restart, hence the signal below.
#
# If yabai ever starts prompting for a password here, the binary was rebuilt
# without refreshing the sudoers entry — re-run `make install-local`.
# Quick test: `sudo -n yabai --load-sa` (exit 0 = fine, prompt = stale).
sudo yabai --load-sa
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"

# ── layout ────────────────────────────────────────────────────────────────
# Commented out for now -> yabai's built-in default is float, so nothing gets
# tiled automatically. Re-enable once your skhd bindings are set up.
# yabai -m config layout                      bsp
yabai -m config window_placement            second_child
yabai -m config window_insertion_point      focused
yabai -m config split_ratio                 0.50
yabai -m config auto_balance                off

# ── gaps & padding (tuned for your single 1512x982 display) ───────────────
# Modest values so you don't lose much usable area on a laptop screen.
yabai -m config top_padding                 8
yabai -m config bottom_padding              8
yabai -m config left_padding                8
yabai -m config right_padding               8
yabai -m config window_gap                  8

# ── mouse ─────────────────────────────────────────────────────────────────
yabai -m config mouse_follows_focus         off
yabai -m config focus_follows_mouse         off
# Combined modifiers need the local patch in src/mouse_handler.h +
# src/message.c -- see PATCHES.md in the yabai repo. Stock yabai accepts only
# ONE modifier here and will reject this line.
#
# Must stay in sync with the Karabiner rules, which press button1 while
# left-ctrl + left-option are held. Matching is EXACT: any extra modifier
# (cmd, shift, fn) means no match and the click falls through to the app.
yabai -m config mouse_modifier              ctrl+alt

# Don't replay a hyper+click into the app when no drag followed. Without this,
# every hyper chord held past the Karabiner threshold (hold caps_lock, press s)
# ends as a stray click under the pointer. Also requires the local patch.
yabai -m config mouse_replay_click          off
yabai -m config mouse_drop_action           swap

# ── appearance (these require the scripting addition) ─────────────────────
# 'float' would draw shadows ONLY on floating windows, so tiled (bsp) windows
# lose them. 'on' keeps shadows in both layouts.
yabai -m config window_shadow               on
yabai -m config window_animation_duration   0.15
yabai -m config window_animation_easing     ease_out_circ

# ── rules: leave alone what shouldn't be tiled ────────────────────────────
yabai -m rule --add app="^System Settings$"                     manage=off
yabai -m rule --add app="^Archive Utility$"                     manage=off
yabai -m rule --add app="^Calculator$"                          manage=off
yabai -m rule --add app="^Software Update$"                     manage=off
yabai -m rule --add app="^Activity Monitor$"                    manage=off
yabai -m rule --add app="^Keychain Access$"                     manage=off
yabai -m rule --add app="^Raycast$"                             manage=off
yabai -m rule --add app="^Finder$" title="^(Copy|Connect|Move|Info|Get Info)" manage=off

# ── spaces: force exactly 9, labelled ─────────────────────────────────────
# What each space is for lives in reset-spaces.sh (see roelOS/content/spaces.md)
# — EDIT THE LABELS THERE, not here. Labels double as identifiers in commands,
# e.g. yabai -m window --space "Coding & Automation", and the window-mode HUD
# shows the current one in its top-right corner.
#
# If the count is sane (8 or 9) the script only re-applies labels — a ~60ms
# no-op, so restarting yabai mid-session does NOT shuffle your desktop. If the
# count is messed up (< 8 or > 9) it destroys every space down to the last one
# (yabai cannot destroy a display's final space) and creates 8 fresh ones to
# land on exactly 9. Windows on destroyed spaces migrate to a neighbour rather
# than closing, so after a reset they pile up on the surviving space.
#
# Runs in the FOREGROUND deliberately. Backgrounding it would shave ~1.5s off a
# cold start (space creation costs ~150ms each through the SA), but it would
# also race space --create against yabai's own startup for no real benefit —
# this is the last thing in the file, so nothing is waiting on it anyway.
"$HOME/.config/yabai/reset-spaces.sh" 1

# Exit 10 means it actually created or destroyed spaces. Only then do wallpapers
# need re-applying, because a new space starts on the macOS default — otherwise
# the per-space wallpapers already persist in com.apple.wallpaper's store.
#
# Gating on this matters: set-wallpapers.sh has to VISIT all nine spaces (there
# is no API to dress a space you aren't on), so running it unconditionally would
# make every yabai restart flick through your desktops for a few seconds.
[ $? -eq 10 ] && "$HOME/.config/yabai/set-wallpapers.sh" 1

# ── apps: a home space per app, opened at login ───────────────────────────
# WHICH app goes WHERE lives in apps.conf (same folder) — edit that, then
# check it with `place-apps.sh check`. place-apps.sh is only the machinery.
#
# `rules` adds one yabai rule per app (space=…), then `rule --apply` moves
# already-open windows home. The rules are one-shot: `launch` removes them
# after settling, so a new window made mid-session stays on the current space.
# Must run AFTER reset-spaces.sh: yabai resolves `space=` to a space ID when
# the rule is added, and reset-spaces.sh may have just created fresh ones.
# Foreground, ~100ms.
#
# `launch` opens every listed app that isn't running, without stealing focus.
# Backgrounded: it sleeps between launches and nothing here waits on it. It
# skips running apps, so a restart mid-session relaunches nothing.
"$HOME/.config/yabai/place-apps.sh" rules
"$HOME/.config/yabai/place-apps.sh" launch >/dev/null 2>&1 &

echo "yabai configuration loaded.."
